# URL del backend FastAPI (HTTP). Tailscale: IP de la PC con GPU (puerto 8000 opcional).
NEXT_PUBLIC_API_URL=http://localhost:8000
# Host para WebSocket (misma IP; puerto 8000 opcional, se agrega solo si falta)
NEXT_PUBLIC_API_HOST=localhost:8000
